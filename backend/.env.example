### Backend environment example for WhatsApp proxy
# Choose provider: callmebot | twilio | messagebird
WHATSAPP_PROVIDER=callmebot

# CallMeBot (simple test provider)
CALLMEBOT_API_KEY=

# Twilio (if used)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_WHATSAPP_FROM=+225XXXXXXXXX

# MessageBird (if used)
MESSAGEBIRD_API_KEY=

# App / Auth
APP_NAME=EGS Local API
DATABASE_URL=
LOCAL_AUTH_SECRET=
INITIAL_ADMIN_PASSWORD=
AUTO_RESET_DEFAULT_ADMIN_PASSWORD=false
EGS_ADMIN_TOTP_SECRET=
EGS_ADMIN_TOTP_USER_ID=
LOCAL_AUTH_ACCESS_TOKEN_TTL_SECONDS=600
LOCAL_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_REQUIRE_HTTPS=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_RESET_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_TTL_SECONDS=1800
PUBLIC_APP_URL=https://gnambaservices.ci
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SQL_ECHO=false

# PostgreSQL connection pool
# Size the pool per API process; total connections are roughly
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) * number_of_backend_workers.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# WhatsApp Business API (Meta)
#WHATSAPP_BUSINESS_TOKEN=
#WHATSAPP_BUSINESS_NUMBER=1234567890
