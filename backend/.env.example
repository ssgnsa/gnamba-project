### Backend environment example for WhatsApp proxy
# Choose provider: callmebot | twilio | messagebird
WHATSAPP_PROVIDER=callmebot

# CallMeBot (simple test provider)
CALLMEBOT_API_KEY=

# Twilio (if used)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_WHATSAPP_FROM=+225XXXXXXXXX

# MessageBird (if used)
MESSAGEBIRD_API_KEY=

# App / Auth
APP_NAME=EGS Local API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/egs_local
LOCAL_AUTH_SECRET=egs-local-dev-secret-change-me
LOCAL_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
LOCAL_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
SQL_ECHO=false

# WhatsApp Business API (Meta)
#WHATSAPP_BUSINESS_TOKEN=
#WHATSAPP_BUSINESS_NUMBER=1234567890
