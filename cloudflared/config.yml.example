## Example Cloudflared config for gnambaservices
# Copy to /etc/cloudflared/config.yml and update paths/IDs

tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: gnambaservices.ci
    service: http://127.0.0.1:8080
  - hostname: www.gnambaservices.ci
    service: http://127.0.0.1:8080
  - hostname: portal.gnambaservices.ci
    service: http://127.0.0.1:8080
  - hostname: api.gnambaservices.ci
    service: http://127.0.0.1:54321
  - service: http_status:404

# Optional: origin cert verification and other settings
# originRequest:
#   connectTimeout: 30s
#   noTLSVerify: false
