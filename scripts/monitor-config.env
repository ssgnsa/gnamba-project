# Configuration du monitoring Gnamba Server
# Date: 13 mai 2026

# Alertes par email (nécessite mailutils ou postfix)
EMAIL_RECIPIENT=admin@gnamba-services.com

# Alertes Slack (optionnel)
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Alertes Telegram (optionnel)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Seuils de monitoring
DISK_THRESHOLD=90        # Pourcentage d'utilisation disque critique
BACKUP_MAX_AGE=24        # Âge maximum du dernier backup en heures

# Services à surveiller
MONITOR_DOCKER=true
MONITOR_SUPABASE=true
MONITOR_DATABASE=true
MONITOR_BACKUPS=true
MONITOR_DISK=true
MONITOR_GIT=true