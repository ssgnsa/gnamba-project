# ============================================
# Dockerfile avec variables runtime (PAS de secrets dans build)
# ============================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copier package files
COPY package*.json ./
RUN npm ci

# Copier source
COPY . .

# Build avec variables placeholder (seront remplacées au runtime)
RUN npm run build

# Production stage
FROM nginx:alpine

# Installation des outils
RUN apk add --no-cache bash curl envsubst

# Copy nginx config (standalone - sans filebrowser)
COPY nginx-standalone.conf /etc/nginx/conf.d/default.conf.template

# Script d'entrypoint pour substitution runtime
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy built app
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Entrypoint pour substitution des variables
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
