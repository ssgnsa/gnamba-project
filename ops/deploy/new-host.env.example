# Copy to .env.new-host on the isolated Docker host and replace every value.
# Keep .env.new-host outside Git with mode 0600. Generate secrets with
# `openssl rand -hex 32`; never reuse credentials from the current production host.
EGS_EXPECTED_HOSTNAME=
EGS_API_ENV_FILE=.env.new-host-api
POSTGRES_PASSWORD=
EGS_DB_APP_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
LOCAL_AUTH_SECRET=
INITIAL_ADMIN_PASSWORD=
FB_ADMIN_PASSWORD=

# Set the public HTTPS origins belonging to the new host/reverse proxy.
PUBLIC_APP_URL=
VITE_API_URL=
VITE_LOCAL_API_URL=
VITE_STORAGE_BASE_URL=https://files.gnambaservices.ci/egs
CORS_ORIGINS=

# Optional: SMTP settings, ports, and API request limits.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
API_PORT=18000
WEB_PORT=18080
