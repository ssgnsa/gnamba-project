{
  "name": "egs-enterprise-gnamba-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:codex": "tsc --noEmit -p tsconfig.codex.json",
    "build:verify": "npm run typecheck && npm run build && npm run validate:frontend",
    "validate:frontend": "bash scripts/validate-frontend-release.sh --strict",
    "selfhosted:check": "bash scripts/selfhosted-check.sh",
    "selfhosted:validate": "bash scripts/validate-selfhosted.sh",
    "selfhosted:guard": "node scripts/check-legacy-supabase.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "backup": "bash scripts/backup/backup-manager.sh backup remote --full",
    "backup:local": "bash scripts/backup/backup-manager.sh backup local --full",
    "backup:restore": "bash scripts/backup/backup-manager.sh restore",
    "backup:verify": "bash scripts/backup/backup-manager.sh verify",
    "backup:list": "bash scripts/backup/backup-manager.sh list",
    "backup:cleanup": "bash scripts/backup/backup-manager.sh cleanup",
    "backup:schedule": "bash scripts/backup/backup-scheduler.sh",
    "ops:status": "bash scripts/workspace-stack.sh status",
    "ops:doctor": "bash scripts/workspace-doctor.sh",
    "ops:egs:schema-audit": "bash scripts/egs-schema-audit.sh",
    "ops:egs:schema:refresh": "bash scripts/refresh-egs-schema.sh",
    "ops:ports": "bash scripts/workspace-stack.sh ports",
    "ops:egs:local:start": "bash scripts/workspace-stack.sh egs start-local",
    "ops:egs:local:stop": "bash scripts/workspace-stack.sh egs stop-local",
    "ops:egs:mode:local": "bash scripts/workspace-stack.sh egs set-mode local",
    "ops:egs:db:dry-run": "bash scripts/workspace-stack.sh egs db-push --dry-run",
    "ops:egs:db:push": "bash scripts/workspace-stack.sh egs db-push --apply",
    "audit:foncier": "bash scripts/audit-foncier.sh",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "db:local:start": "bash scripts/database/postgres-local.sh start",
    "db:local:stop": "bash scripts/database/postgres-local.sh stop",
    "db:local:status": "bash scripts/database/postgres-local.sh status",
    "db:local:logs": "bash scripts/database/postgres-local.sh logs",
    "db:local:shell": "bash scripts/database/postgres-local.sh shell",
    "db:local:reset": "bash scripts/database/postgres-local.sh reset",
    "supabase:migrations:sync": "bash scripts/sync-supabase-migrations.sh",
    "attestation:pdf": "node scripts/generate-attestation-pdf.mjs --data scripts/attestation-data.example.json --output dist/attestation-ministere.pdf",
    "workflow:init": "bash scripts/init-workflow.sh",
    "sync:status": "bash scripts/sync-workflow.sh status",
    "sync:verify": "bash scripts/sync-workflow.sh verify",
    "sync:dev-to-server": "bash scripts/sync-workflow.sh sync local-dev local-server",
    "sync:dev-to-prod": "bash scripts/sync-workflow.sh sync local-dev local-server",
    "sync:server-to-prod": "bash scripts/sync-workflow.sh sync local-server local-server",
    "deploy:dev": "bash scripts/deploy.sh local-dev",
    "deploy:server": "bash scripts/deploy.sh local-server",
    "deploy:prod": "bash scripts/deploy.sh local-server",
    "monitor:status": "bash scripts/monitor.sh status",
    "monitor:watch": "bash scripts/monitor.sh watch",
    "monitor:health": "bash scripts/monitor.sh health",
    "monitor:report": "bash scripts/monitor.sh report",
    "codex": "node scripts/codex/run-codex.mjs",
    "codex:status": "npm run codex -- status",
    "codex:health": "npm run codex -- health",
    "codex:plan": "npm run codex -- plan",
    "codex:migrate": "npm run codex -- migrate",
    "codex:backup": "npm run codex -- backup",
    "codex:rollback": "npm run codex -- rollback",
    "codex:optimize": "npm run codex -- optimize",
    "codex:docs": "npm run codex -- docs"
  },
  "dependencies": {
    "dockerode": "^5.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.3",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-onesignal": "^3.5.5",
    "react-turnstile": "^1.0.0",
    "ws": "^8.20.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^1.4.0",
    "@vitest/ui": "^1.4.0",
    "autoprefixer": "^10.4.18",
    "commander": "^14.0.3",
    "esbuild": "^0.27.7",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "puppeteer": "^23.0.0",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.0.2",
    "vitest": "^1.4.0"
  }
}
