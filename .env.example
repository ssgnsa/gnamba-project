# ============================================
# EGS - Enterprise Gnamba System
# Fichier d'exemple de variables d'environnement
# Architecture : PostgreSQL + FastAPI + nginx + Cloudflare Tunnel
# AUCUNE dépendance Supabase
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================

# ============================================
# MODE API LOCAL (FastAPI sur port 8000)
# ============================================
VITE_API_MODE=local

# URL de l'API FastAPI backend (via Cloudflare Tunnel en prod)
# En dev local : http://localhost:8000/api/v1
# En prod : https://api.gnambaservices.ci/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# URL locale de l'API (fallback développement)
VITE_LOCAL_API_URL=http://localhost:8000/api/v1

# ============================================
# BASE DE DONNÉES POSTGRESQL LOCALE
# ============================================
POSTGRES_PASSWORD=postgres

# Secret JWT pour l'auth locale (min. 32 caractères)
# Générer avec: openssl rand -base64 48
JWT_SECRET=votre_jwt_secret_tres_long_et_aleatoire_32_caracteres_minimum

# Mot de passe initial pour l'admin par défaut (changer en prod !)
# Si non défini, utilise "Admin@EGS2025!" par défaut
INITIAL_ADMIN_PASSWORD=Admin@EGS2025!

# ============================================
# CLOUDFLARE TURNSTILE (Captcha - Optionnel)
# ============================================
# Clé de site publique (pour le frontend)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=votre_turnstile_site_key

# Clé secrète (pour vérification backend)
CLOUDFLARE_TURNSTILE_SECRET_KEY=votre_turnstile_secret_key

# ============================================
# PORTS
# ============================================
WEB_PORT=8080
FILEBROWSER_PORT=8081
API_PORT=8000

# FileBrowser API Configuration
VITE_FILEBROWSER_URL=/filebrowser
VITE_FILEBROWSER_API_URL=/filebrowser/api

# ============================================
# WOPI / COLLABORA (Optionnel)
# ============================================
WOPI_JWT_SECRET=votre_clef_jwt_tres_forte
WOPI_API_KEY=change-me-strong-api-key
WOPI_DOC_ROOT=/srv/egs-docs
WOPI_BASE_URL=http://localhost:3000
COLLABORA_URL=http://127.0.0.1:9980

# ============================================
# SAMBA / N8N (Optionnel)
# ============================================
SAMBA_PUID=1000
SAMBA_PGID=1000
SAMBA_USERNAME=egsuser
SAMBA_PASSWORD=replace_with_strong_password
TZ=Africa/Abidjan

N8N_USER=admin
N8N_PASSWORD=changeMe

# ============================================
# MONITORING & ERROR TRACKING (Sentry)
# ============================================
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================
# OLLAMA (Local AI - Optionnel)
# ============================================
VITE_OLLAMA_URL=http://ollama.local:11434
VITE_OLLAMA_MODEL=llama3.1:8b

# OneSignal
VITE_ONESIGNAL_APP_ID=votre_onesignal_app_id
VITE_ONESIGNAL_API_KEY=votre_onesignal_api_key
VITE_ONESIGNAL_USER_AUTH_KEY=votre_onesignal_user_auth_key

# ============================================
# TIMEOUT
# ============================================
VITE_IDLE_TIMEOUT_MINUTES=30

# ============================================
# VARIABLES DOCKER COMPOSE (egs-api)
# ============================================
DATABASE_URL=postgresql://postgres:EgsProdPostgres2026Secure@egs-postgres:5432/egs_local
LOCAL_AUTH_SECRET=votre_jwt_secret_tres_long_et_aleatoire_32_caracteres_minimum
LOCAL_AUTH_ACCESS_TOKEN_TTL_SECONDS=1800
LOCAL_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
SQL_ECHO=false
CORS_ORIGINS=http://localhost:8080,https://gnambaservices.ci,https://www.gnambaservices.ci,https://api.gnambaservices.ci

# ============================================
# WhatsApp providers (server-side)
# ============================================
# Provider: callmebot | twilio | messagebird | whatsapp_business_api
WHATSAPP_PROVIDER=callmebot

# CallMeBot (test)
CALLMEBOT_API_KEY=

# Twilio (Programmable Messaging - WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# MessageBird
MESSAGEBIRD_API_KEY=

# WhatsApp Business API (Meta / Facebook)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=

# If true, the seed routine may reset the default admin password on startup.
# Set to false to preserve an existing custom admin password in the DB.
AUTO_RESET_DEFAULT_ADMIN_PASSWORD=false