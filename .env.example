# ============================================
# EGS - Enterprise Gnamba System
# Fichier d'exemple de variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================

# ============================================
# MODE DE CONNEXION SUPABASE
# ============================================
# Mode actuel recommandé: 'local' via Cloudflare Tunnel
SUPABASE_MODE=local
VITE_SUPABASE_MODE=local

# ============================================
# SUPABASE LOCAL (Déploiement tunnel / serveur)
# ============================================
# URL locale du Supabase local exposé sur le réseau local
VITE_SUPABASE_LOCAL_URL=http://localhost:54321

# Clé anonyme Supabase Local (défaut Supabase)
# Cette clé est publique et doit commencer par "sb_"
VITE_SUPABASE_LOCAL_ANON_KEY=sb_publishable_your_local_anon_key_here

# Mot de passe PostgreSQL local
POSTGRES_PASSWORD=postgres

# Secret JWT pour Supabase local (min. 32 caractères)
# Générer avec: openssl rand -base64 48
JWT_SECRET=votre_jwt_secret_tres_long_et_aleatoire_32_caracteres_minimum

# ============================================
# CLOUDFLARE TURNSTILE (Captcha - Optionnel)
# ============================================
# Clé de site publique (pour le frontend)
# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=votre_turnstile_site_key

# Clé secrète (pour vérification backend)
# CLOUDFLARE_TURNSTILE_SECRET_KEY=votre_turnstile_secret_key

# ============================================
# DEPLOYMENT & PRODUCTION
# ============================================
# Origine canonique pour la redirection d'URL
# VITE_CANONICAL_ORIGIN=http://localhost:8080

# Domaine principal utilisé par la stack de production
# EGS_DOMAIN=localhost

# Ports exposés
WEB_PORT=80
FILEBROWSER_PORT=8081

# FileBrowser API Configuration
# Development: http://localhost:8081
# Production: use the same-origin reverse proxy to avoid client-side localhost calls
VITE_FILEBROWSER_URL=/filebrowser
VITE_FILEBROWSER_API_URL=/filebrowser/api

# WOPI Gateway
WOPI_JWT_SECRET=votre_clef_jwt_tres_forte
WOPI_API_KEY=change-me-strong-api-key
WOPI_DOC_ROOT=/srv/egs-docs
WOPI_BASE_URL=http://localhost:3000
COLLABORA_URL=http://127.0.0.1:9980

# Samba
SAMBA_PUID=1000
SAMBA_PGID=1000
SAMBA_USERNAME=egsuser
SAMBA_PASSWORD=replace_with_strong_password
TZ=Africa/Abidjan

# n8n
N8N_USER=admin
N8N_PASSWORD=changeMe

# ============================================
# MONITORING & ERROR TRACKING (Sentry)
# ============================================
# Create a free project at https://sentry.io
# Get your DSN from Settings > Client Keys
# Free tier: 5,000 errors/month
# VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================
# MODE AUTO-HÉBERGÉ / LOCAL FIRST
# ============================================
VITE_SELFHOSTED_MODE=true
VITE_LOCAL_API_URL=http://localhost:8000
VITE_STORAGE_BASE_URL=http://localhost:9000/egs
VITE_ENABLE_ONESIGNAL=false
VITE_ENABLE_TURNSTILE=false
VITE_ENABLE_SENTRY=false

# ============================================
# OLLAMA (Local AI - Optionnel)
# ============================================
# URL de l'instance Ollama (par défaut: http://localhost:11434)
# VITE_OLLAMA_URL=http://localhost:11434

# Modèle par défaut (doit être installé dans Ollama)
# Recommandés: llama3.1:8b, qwen2.5:7b, phi3:3.8b
# VITE_OLLAMA_MODEL=llama3.1:8b

# ============================================
# NOTES DE SÉCURITÉ
# ============================================
# 1. NE JAMAIS committer .env dans Git
# 2. Utiliser des secrets forts (min. 32 caractères aléatoires)
# 3. Rotation régulière des clés (tous les 90 jours)
# 4. Utiliser un gestionnaire de mots de passe (1Password, Bitwarden)
# ============================================
